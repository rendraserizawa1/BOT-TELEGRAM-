# -- Berkas RUNTIME (dibuat proses saat berjalan, bukan kode) -------------
# Lock berisi PID yang berubah tiap start; meng-commit-nya membuat konflik
# palsu setiap kali dan bisa menyesatkan pembaca tentang siapa pemilik lock.
boot/*.lock
boot/.jaga-*.lock
boot/.push-agen.lock
boot/*-status.json
boot/push-agen.log
boot/*.log
