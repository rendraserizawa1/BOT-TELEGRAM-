# ══════════════════════════════════════════
# DATA RUNTIME BOT — JANGAN PERNAH DI-COMMIT
# ══════════════════════════════════════════
# data/ berisi:
#   bot.db (+ -wal/-shm) = SELURUH riwayat chat, sesi, file, kredensial
#   data/backups/        = salinan DB
#   data/secure/env.backup = SALINAN .env (berisi token & key!)
#   data/files/          = berkas yang dikirim/diterima lewat bot
# Ini data privat pengguna, bukan kode. Tidak boleh masuk repo.
data/

# Arsip snapshot manual (salinan index.js dll) — tidak perlu di repo
backup/

# Artefak sementara pengujian/diagnostik di boot/
boot/_*.txt
boot/_*.log
boot/_*.json
# Skrip probe & diagnostik sekali-pakai (tidak dipakai produksi).
# Test suite resmi (boot/test-*.js, boot/verify-all.js) TETAP di-commit.
boot/_*.js
boot/_*.err
boot/_*.out
boot/_*.lock
boot/probe-*.js
boot/uji-*.js
boot/diag-*.js
boot/monitor-*.js
boot/profile-*.js
# PENGECUALIAN: uji & probe ini WAJIB ikut ke dalam image karena dijalankan
# DI DALAM container Railway untuk membuktikan jalur tailnet sebelum
# IPOS_*_URL diubah. Tanpa ini, verifikasi mustahil dilakukan dari luar.
!boot/uji-tailscale.js
!boot/probe-tailnet.js
boot/koreksi-cek.js
boot/lihat-db.js
boot/tunggu-notif.js
boot/cek-notif-lengkap.js

# Skrip uji sekali-pakai di root
tmp-*.js
test_backup_*.js
test_sync_github_alias.js

