# Template aman untuk Git. Salin ke .env; jangan isi atau unggah rahasia di template ini.
# Wajib. Buat bot via @BotFather; isi token lokal di .env.
BOT_TOKEN=
ADMIN_ID=

# Opsional — AI
GEMINI_KEY=
GEMINI_KEY2=
GEMINI_KEY3=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Opsional — Dashboard, ubah password default sebelum akses jaringan.
DASHBOARD_USER=admin
DASHBOARD_PASS=
SESSION_SECRET=
PORT=3000

# Opsional — sinkronisasi Excel harga dari private GitHub data repo.
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPO=
GITHUB_BRANCH=data-storage
GITHUB_TIMEOUT_MS=12000

# Opsional — iPos; CP, NK, KEFA perlu URL/key/API reachable dari komputer ini.
IPOS_URL=
IPOS_KEY=
IPOS_TOKO=cp
IPOS_NK_URL=
IPOS_NK_KEY=
IPOS_NK_TOKO=nk
IPOS_KEFA_URL=
IPOS_KEFA_KEY=
IPOS_KEFA_TOKO=kefa
IPOS_SYNC_MS=15000
IPOS_TIMEOUT_MS=15000
IPOS_CATALOG_TIMEOUT_MS=60000
